# Copy OUTSIDE the checkout, chmod 0600, and edit there. This file is not a working deployment.
# Use docker compose --env-file /absolute/relay.env -f deploy/commercial/compose.yaml ...
RELAY_IMAGE_TAG=3.0.0-review
RELAY_ENV_FILE=/absolute/path/to/relay.env
RELAY_SECRETS_DIR=/absolute/path/to/relay-secrets
RELAY_TLS_DIR=/absolute/path/to/relay-tls
# Local review binding. A public release must deliberately choose its ingress binding.
RELAY_HTTPS_BIND=127.0.0.1:8443
# Pin these to reviewed immutable digests for a production build.
RELAY_PYTHON_IMAGE=python:3.12-slim-bookworm
RELAY_UV_IMAGE=ghcr.io/astral-sh/uv:0.12.5
RELAY_PROXY_IMAGE=nginx:stable-alpine

RELAY_ENV=production
PUBLIC_URL=https://relay.example.invalid
DJANGO_SECRET_KEY=
# Use a dedicated PostgreSQL database/account. URL-encode special password characters.
DATABASE_URL=
DATABASE_SSLMODE=verify-full
PGSSLROOTCERT=/run/relay-secrets/postgres-ca.pem
LICENSE_PRIVATE_KEY_FILE=/run/relay-secrets/license-ed25519.pem

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=
LEGAL_ENTITY_NAME=

# Defaults remain closed until each real merchant integration is independently accepted.
SIMULATED_PAYMENTS=0
WECHAT_ENABLED=0
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=/run/relay-secrets/wechat-private.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_FILE=/run/relay-secrets/wechat-platform-public.pem
WECHAT_API_V3_KEY=
ALIPAY_ENABLED=0
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/relay-secrets/alipay-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/relay-secrets/alipay-platform-public.pem
