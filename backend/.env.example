# Shell environment example; Django does not automatically load this file.
# Development only. Do not put production secrets in the repository.
RELAY_ENV=development
PUBLIC_URL=http://127.0.0.1:8016
SIMULATED_PAYMENTS=0
WECHAT_ENABLED=0
ALIPAY_ENABLED=0
# Optional absolute external data directory:
# RELAY_RUNTIME_DIR=/absolute/path/to/relay-runtime
# Default development mail is written locally, not sent to recipients.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL='NetCare <development@localhost>'
